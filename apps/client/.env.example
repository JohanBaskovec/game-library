# Settings for a build of the client that the Node.js server does not serve itself (the native app).
# Copy to `.env.local` and fill in. A website served by the server needs none of this.

# Address of the server (HTTP API and room WebSockets), without a trailing slash.
# Without it the native app has no rooms and says so.
VITE_SERVER_URL=https://games.example.com

# Address of the public website: the links and QR codes players share open this (defaults to the server).
VITE_PUBLIC_URL=https://games.example.com
