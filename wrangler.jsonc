{
  // Cloudflare Workers configuration: the website (static assets) and the rooms (a Worker with Durable Objects).
  // The Worker name must match the name of the Worker in the Cloudflare dashboard.
  "name": "game-library",
  "main": "./apps/server-cloudflare/src/worker.ts",
  "compatibility_date": "2026-11-26",
  "assets": {
    "directory": "./apps/client/dist",
    // Only the API reaches the Worker; every other path is a file of the website, served without running code.
    "run_worker_first": ["/api/*"],
  },
  "durable_objects": {
    "bindings": [
      // One object per room (named by its code), and one per address for the limits on rooms and guesses.
      { "name": "ROOMS", "class_name": "RoomDO" },
      { "name": "LIMITER", "class_name": "LimiterDO" },
    ],
  },
  "migrations": [
    // SQLite-backed objects. A class is added or renamed by a new migration, never by editing this one.
    { "tag": "v1", "new_sqlite_classes": ["RoomDO", "LimiterDO"] },
  ],
  "vars": {
    // Origins allowed to call the API from a browser, separated by commas. Empty: any (the API has no cookies).
    "ALLOWED_ORIGINS": "",
  },
  "observability": { "enabled": true },
}
